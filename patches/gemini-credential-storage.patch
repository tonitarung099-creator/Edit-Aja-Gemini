+void AiAssistantWidget::loadPersistedGeminiCredentials()
+{
+    if (!m_agent || !GeminiCredentialStore::isAvailable()) {
+        return;
+    }
+    QString error;
+    const QList<GeminiStoredCredential> stored = GeminiCredentialStore::load(&error);
+    if (!error.isEmpty()) {
+        appendTrace(QStringLiteral("<b>%1</b> %2").arg(i18n("Gemini secure storage:"), error.toHtmlEscaped()));
+        return;
+    }
+    for (const GeminiStoredCredential &credential : stored) {
+        QString addError;
+        if (m_agent->addCredential(credential.apiKey, credential.label, credential.projectId, &addError)) {
+            m_geminiCredentialTargets.push_back(credential.targetName);
+        }
+    }
+    refreshGeminiCredentialList();
+}
