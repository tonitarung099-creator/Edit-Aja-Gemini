+++ b/src/aiassistant/geminicredentialstore.h
@@ -0,0 +1,34 @@
+/*
+    SPDX-FileCopyrightText: 2026 Edit Aja contributors
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#pragma once
+
+#include <QList>
+#include <QString>
+
+struct GeminiStoredCredential
+{
+    QString targetName;
+    QString apiKey;
+    QString label;
+    QString projectId;
+};
+
+/**
+ * Stores Gemini API keys in the operating-system credential vault.
+ *
+ * On Windows this uses CRED_TYPE_GENERIC entries in Windows Credential Manager.
+ * Raw API keys are never written to QSettings or project files.
+ */
+class GeminiCredentialStore
+{
+public:
+    static bool isAvailable();
+    static QList<GeminiStoredCredential> load(QString *error = nullptr);
+    static bool save(const QString &apiKey, const QString &label, const QString &projectId, QString *targetName = nullptr,
+                     QString *error = nullptr);
+    static bool remove(const QString &targetName, QString *error = nullptr);
+};
