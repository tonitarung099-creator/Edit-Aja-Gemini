diff --git a/src/aiassistant/geminicredentialstore.cpp b/src/aiassistant/geminicredentialstore.cpp
new file mode 100644
index 0000000..7864bce
--- /dev/null
+++ b/src/aiassistant/geminicredentialstore.cpp
@@ -0,0 +1,188 @@
+/*
+    SPDX-FileCopyrightText: 2026 Edit Aja contributors
+
+    SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+*/
+
+#include "geminicredentialstore.h"
+
+#include <QCryptographicHash>
+#include <QJsonDocument>
+#include <QJsonObject>
+
+#include <algorithm>
+
+#ifdef Q_OS_WIN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <wincred.h>
+#endif
+
+namespace {
+const QString kCredentialPrefix = QStringLiteral("EditAjaGemini/GeminiApiKey/");
+
+QString targetForKey(const QString &apiKey)
+{
+    const QByteArray digest = QCryptographicHash::hash(apiKey.trimmed().toUtf8(), QCryptographicHash::Sha256).toHex();
+    return kCredentialPrefix + QString::fromLatin1(digest);
+}
+
+void setError(QString *error, const QString &message)
+{
+    if (error) {
+        *error = message;
+    }
+}
+
+#ifdef Q_OS_WIN
+QString windowsError(const QString &operation)
+{
+    return QStringLiteral("%1 failed with Windows error %2.").arg(operation).arg(GetLastError());
+}
+#endif
+} // namespace
+
+bool GeminiCredentialStore::isAvailable()
+{
+#ifdef Q_OS_WIN
+    return true;
+#else
+    return false;
+#endif
+}
+
+QList<GeminiStoredCredential> GeminiCredentialStore::load(QString *error)
+{
+    QList<GeminiStoredCredential> result;
+    if (error) {
+        error->clear();
+    }
+
+#ifdef Q_OS_WIN
+    const QString filter = kCredentialPrefix + QLatin1Char('*');
+    DWORD count = 0;
+    PCREDENTIALW *credentials = nullptr;
+    if (!CredEnumerateW(reinterpret_cast<LPCWSTR>(filter.utf16()), 0, &count, &credentials)) {
+        const DWORD code = GetLastError();
+        if (code == ERROR_NOT_FOUND) {
+            return result;
+        }
+        setError(error, QStringLiteral("Could not read Gemini keys from Windows Credential Manager (error %1).").arg(code));
+        return result;
+    }
+
+    for (DWORD i = 0; i < count; ++i) {
+        const PCREDENTIALW credential = credentials[i];
+        if (!credential || credential->Type != CRED_TYPE_GENERIC || !credential->TargetName) {
+            continue;
+        }
+        const QString target = QString::fromWCharArray(credential->TargetName);
+        if (!target.startsWith(kCredentialPrefix)) {
+            continue;
+        }
+        const QByteArray blob(reinterpret_cast<const char *>(credential->CredentialBlob), static_cast<qsizetype>(credential->CredentialBlobSize));
+        QJsonParseError parseError;
+        const QJsonDocument document = QJsonDocument::fromJson(blob, &parseError);
+        if (parseError.error != QJsonParseError::NoError || !document.isObject()) {
+            continue;
+        }
+        const QJsonObject object = document.object();
+        GeminiStoredCredential stored;
+        stored.targetName = target;
+        stored.apiKey = object.value(QStringLiteral("apiKey")).toString().trimmed();
+        stored.label = object.value(QStringLiteral("label")).toString();
+        stored.projectId = object.value(QStringLiteral("projectId")).toString();
+        if (!stored.apiKey.isEmpty()) {
+            result.push_back(stored);
+        }
+    }
+    CredFree(credentials);
+
+    std::sort(result.begin(), result.end(), [](const GeminiStoredCredential &left, const GeminiStoredCredential &right) {
+        const int labelOrder = QString::localeAwareCompare(left.label, right.label);
+        if (labelOrder != 0) {
+            return labelOrder < 0;
+        }
+        return left.targetName < right.targetName;
+    });
+#endif
+
+    return result;
+}
+
+bool GeminiCredentialStore::save(const QString &apiKey, const QString &label, const QString &projectId, QString *targetName, QString *error)
+{
+    if (error) {
+        error->clear();
+    }
+    const QString normalizedKey = apiKey.trimmed();
+    if (normalizedKey.isEmpty()) {
+        setError(error, QStringLiteral("Gemini API key is empty."));
+        return false;
+    }
+
+#ifdef Q_OS_WIN
+    const QString target = targetForKey(normalizedKey);
+    const QByteArray blob = QJsonDocument(QJsonObject{{QStringLiteral("apiKey"), normalizedKey},
+                                                       {QStringLiteral("label"), label.trimmed()},
+                                                       {QStringLiteral("projectId"), projectId.trimmed()}})
+                                .toJson(QJsonDocument::Compact);
+    if (blob.size() > CRED_MAX_CREDENTIAL_BLOB_SIZE) {
+        setError(error, QStringLiteral("Gemini credential metadata is too large for Windows Credential Manager."));
+        return false;
+    }
+
+    CREDENTIALW credential{};
+    credential.Type = CRED_TYPE_GENERIC;
+    credential.TargetName = const_cast<LPWSTR>(reinterpret_cast<LPCWSTR>(target.utf16()));
+    credential.CredentialBlobSize = static_cast<DWORD>(blob.size());
+    credential.CredentialBlob = reinterpret_cast<LPBYTE>(const_cast<char *>(blob.constData()));
+    credential.Persist = CRED_PERSIST_LOCAL_MACHINE;
+
+    if (!CredWriteW(&credential, 0)) {
+        setError(error, windowsError(QStringLiteral("Saving Gemini API key")));
+        return false;
+    }
+    if (targetName) {
+        *targetName = target;
+    }
+    return true;
+#else
+    Q_UNUSED(label)
+    Q_UNUSED(projectId)
+    Q_UNUSED(targetName)
+    setError(error, QStringLiteral("Secure Gemini key persistence is currently available on Windows only."));
+    return false;
+#endif
+}
+
+bool GeminiCredentialStore::remove(const QString &targetName, QString *error)
+{
+    if (error) {
+        error->clear();
+    }
+    if (targetName.isEmpty()) {
+        return true;
+    }
+
+#ifdef Q_OS_WIN
+    if (!targetName.startsWith(kCredentialPrefix)) {
+        setError(error, QStringLiteral("Refusing to delete an unrelated Windows credential."));
+        return false;
+    }
+    if (!CredDeleteW(reinterpret_cast<LPCWSTR>(targetName.utf16()), CRED_TYPE_GENERIC, 0)) {
+        const DWORD code = GetLastError();
+        if (code == ERROR_NOT_FOUND) {
+            return true;
+        }
+        setError(error, QStringLiteral("Could not remove Gemini key from Windows Credential Manager (error %1).").arg(code));
+        return false;
+    }
+    return true;
+#else
+    setError(error, QStringLiteral("Secure Gemini key persistence is currently available on Windows only."));
+    return false;
+#endif
+}
