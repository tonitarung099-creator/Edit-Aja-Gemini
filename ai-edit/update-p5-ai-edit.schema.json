{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://update-p5-edit-aja.local/schema/update-p5-ai-edit-v1.json",
  "title": "Update P5 AI Edit JSON",
  "type": "object",
  "required": ["format", "version", "steps"],
  "properties": {
    "format": {"const": "update-p5-ai-edit"},
    "version": {"const": 1},
    "metadata": {"type": "object"},
    "variables": {"type": "object"},
    "safety": {
      "type": "object",
      "properties": {
        "checkpoint": {"type": "boolean"},
        "checkpoint_label": {"type": "string"}
      },
      "additionalProperties": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tool"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "pattern": "^kdenlive_"},
          "enabled": {"type": "boolean"},
          "arguments": {"type": "object"},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
